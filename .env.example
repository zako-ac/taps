# Where the taps reach HQ. One WebSocket per tap, carrying control only — the
# audio goes straight to whichever sink HQ nominates, over UDP, and never
# crosses this connection. Replaces the old TAPHUB_ENDPOINT/TAPHUB_SERVER_NAME
# pair, which named the taphub QUIC listener rather than HQ.
#
# Default is the in-cluster address; set this to wss://zako.ac/gateway to run a
# tap from outside the cluster.
ZAKO_GATEWAY_URL=ws://zako3-hq:8080/gateway

# Optional HTTP /health port this tap serves for an orchestrator's probes.
# Unrelated to the gateway port above — that one is HQ's, this one is the tap's.
TAP_HEALTHCHECK_PORT=8080

# Google TTS Tap credentials
GOOGLE_TAP_ID=
GOOGLE_API_TOKEN=

# Papago TTS Tap credentials
PAPAGO_TAP_ID=
PAPAGO_API_TOKEN=

# YouTube Tap credentials
YOUTUBE_TAP_ID=
YOUTUBE_API_TOKEN=

# Supertonic TTS Tap credentials
SUPERTONIC_TAP_ID=
SUPERTONIC_API_TOKEN=
# Optional Supertonic config
# SUPERTONIC_MODEL_DIR=./assets/supertonic-3
# SUPERTONIC_VOICE_STYLE=./assets/supertonic-3/voice_styles/M1.json
# SUPERTONIC_LANG=en
# SUPERTONIC_TOTAL_STEP=8
# SUPERTONIC_SPEED=1.05
# SUPERTONIC_SILENCE_DUR=0.3
# SUPERTONIC_WORKERS=2
# SUPERTONIC_HF_REPO=https://huggingface.co/Supertone/supertonic-3
